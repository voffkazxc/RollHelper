<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RollHelperLauncher</AssemblyName>
    <RootNamespace>RollHelperLauncher</RootNamespace>
    <Version>0.1.66</Version>
    <ApplicationIcon>Assets\RollHelperLogo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\RollHelperLogo.png" />
    <Resource Include="Assets\RollHelperLogo.ico" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>RollHelperLauncher.RepairProbe</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
