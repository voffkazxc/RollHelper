<Window x:Class="RollHelperLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RollHelper Launcher"
        Width="980"
        Height="640"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Background="{StaticResource WindowBackgroundBrush}">
    <Window.Resources>
        <Style x:Key="LauncherDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#D7DEE8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="46" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
        </Style>

        <Style x:Key="LauncherColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9EFF6" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="BorderBrush" Value="#D7DEE8" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LauncherCenteredColumnHeaderStyle"
               TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource LauncherColumnHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LauncherRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE1FF" />
                    <Setter Property="Foreground" Value="#0F172A" />
                    <Setter Property="BorderBrush" Value="#60A5FA" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LauncherCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#CFE1FF" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgramNameTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="#0F172A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProgramVersionTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="#0F172A" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderPrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="HeaderCompactButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        </Style>

        <Style x:Key="ProgramActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="230" />
        </Style>

        <Style x:Key="ProgramUpdateActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ProgramActionButtonStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="RollHelper Launcher"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock Text="Программы и дополнения RollHelper"
                               FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="LauncherVersionText"
                               Margin="8,0,0,0"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>

            <WrapPanel Grid.Row="1"
                       Margin="0,14,0,0"
                       HorizontalAlignment="Right">
                <Button x:Name="RefreshButton"
                        Content="Обновить список программ"
                        Margin="0,0,10,0"
                        Style="{StaticResource HeaderPrimaryButtonStyle}"
                        Click="RefreshButton_Click" />
                <Button Content="Открыть лог"
                        Margin="0,0,10,0"
                        Style="{StaticResource HeaderCompactButtonStyle}"
                        Click="OpenLogButton_Click" />
                <Button x:Name="UpdateLauncherButton"
                        Content="Проверить обновление лаунчера"
                        Style="{StaticResource HeaderCompactButtonStyle}"
                        Click="UpdateLauncherButton_Click" />
            </WrapPanel>
        </Grid>

        <Grid x:Name="PackagesLayoutGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ProgramsColumn" Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                <ColumnDefinition x:Name="ModulesColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Программы"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="Выберите программу, чтобы увидеть её дополнения"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <DataGrid x:Name="ProgramsGrid"
                              Grid.Row="2"
                              AutomationProperties.Name="Список программ"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Style="{StaticResource LauncherDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource LauncherColumnHeaderStyle}"
                              RowStyle="{StaticResource LauncherRowStyle}"
                              CellStyle="{StaticResource LauncherCellStyle}"
                              FontFamily="Segoe UI"
                              FontSize="13"
                              SelectionChanged="ProgramsGrid_SelectionChanged"
                              MouseLeftButtonUp="ProgramsGrid_MouseLeftButtonUp"
                              MouseDoubleClick="ProgramsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название"
                                                Binding="{Binding DisplayName}"
                                                ElementStyle="{StaticResource ProgramNameTextStyle}"
                                                Width="1.2*"
                                                MinWidth="110" />
                            <DataGridTextColumn Header="Версия"
                                                Binding="{Binding Version}"
                                                ElementStyle="{StaticResource ProgramVersionTextStyle}"
                                                HeaderStyle="{StaticResource LauncherCenteredColumnHeaderStyle}"
                                                Width="72"
                                                MinWidth="58" />
                            <DataGridTemplateColumn Header="Состояние"
                                                    HeaderStyle="{StaticResource LauncherCenteredColumnHeaderStyle}"
                                                    Width="*"
                                                    MinWidth="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="9,4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E0ECFF" />
                                                     <Style.Triggers>
                                                         <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                             <Setter Property="Background" Value="#2563EB" />
                                                         </DataTrigger>
                                                         <DataTrigger Binding="{Binding Status}" Value="Доступно обновление">
                                                             <Setter Property="Background" Value="#FEF3C7" />
                                                         </DataTrigger>
                                                     </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1D4ED8" />
                                                         <Style.Triggers>
                                                             <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                 <Setter Property="Foreground" Value="White" />
                                                             </DataTrigger>
                                                             <DataTrigger Binding="{Binding Status}" Value="Доступно обновление">
                                                                 <Setter Property="Foreground" Value="#92400E" />
                                                             </DataTrigger>
                                                         </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter x:Name="PackagesSplitter"
                          Grid.Column="1"
                          Width="8"
                          Margin="4,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="#DDE3EA"
                          Cursor="SizeWE"
                          ToolTip="Перетащите, чтобы изменить ширину панелей"
                          Visibility="Collapsed"
                          DragCompleted="PackagesSplitter_DragCompleted"
                          ShowsPreview="True" />

            <Border x:Name="ModulesPanel"
                    Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ModulesHeaderText"
                                       Text="Дополнения"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ModulesHintText"
                                       Margin="0,3,0,0"
                                       Text="Сначала выберите программу слева"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="10,5"
                                MinHeight="30"
                                FontSize="12"
                                VerticalAlignment="Top"
                                Content="Скрыть"
                                ToolTip="Снять выбор программы и закрыть дополнения"
                                Click="HideModulesButton_Click" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="ModulesGrid"
                                  AutomationProperties.Name="Список дополнений"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  Style="{StaticResource LauncherDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource LauncherColumnHeaderStyle}"
                                  RowStyle="{StaticResource LauncherRowStyle}"
                                  CellStyle="{StaticResource LauncherCellStyle}"
                                  FontFamily="Segoe UI"
                                  FontSize="13"
                                  SelectionChanged="ModulesGrid_SelectionChanged"
                                  MouseDoubleClick="ModulesGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu Opened="ModuleContextMenu_Opened">
                                    <MenuItem x:Name="ContextInstallModuleItem"
                                              Header="Установить"
                                              Click="ContextInstallModuleItem_Click" />
                                    <MenuItem x:Name="ContextDisableModuleItem"
                                              Header="Отключить"
                                              Click="ContextDisableModuleItem_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ContextRemoveModuleItem"
                                              Header="Удалить"
                                              Click="ContextRemoveModuleItem_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название"
                                                    Binding="{Binding DisplayName}"
                                                    ElementStyle="{StaticResource ProgramNameTextStyle}"
                                                    Width="1.2*"
                                                    MinWidth="110" />
                                <DataGridTextColumn Header="Версия"
                                                    Binding="{Binding Version}"
                                                    ElementStyle="{StaticResource ProgramVersionTextStyle}"
                                                    HeaderStyle="{StaticResource LauncherCenteredColumnHeaderStyle}"
                                                    Width="72"
                                                    MinWidth="58" />
                                <DataGridTemplateColumn Header="Состояние"
                                                        HeaderStyle="{StaticResource LauncherCenteredColumnHeaderStyle}"
                                                        Width="*"
                                                        MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="9,4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E0ECFF" />
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                     <Setter Property="Background" Value="#2563EB" />
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding Status}" Value="Доступно обновление">
                                                                     <Setter Property="Background" Value="#FEF3C7" />
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1D4ED8" />
                                                             <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                     <Setter Property="Foreground" Value="White" />
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding Status}" Value="Доступно обновление">
                                                                     <Setter Property="Foreground" Value="#92400E" />
                                                                 </DataTrigger>
                                                             </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="ModulesEmptyText"
                                   Text="Для этой программы пока нет дополнений"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="InstallEnableModuleButton"
                                Content="Установить"
                                IsEnabled="False"
                                Click="InstallEnableModuleButton_Click" />
                        <Button x:Name="DisableModuleButton"
                                Grid.Column="2"
                                Content="Отключить"
                                IsEnabled="False"
                                Click="DisableModuleButton_Click" />
                        <Button x:Name="RemoveModuleButton"
                                Grid.Column="4"
                                Content="Удалить"
                                IsEnabled="False"
                                Click="RemoveModuleButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Text="Выберите программу"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <ProgressBar x:Name="DownloadProgress"
                             Height="8"
                             Margin="0,8,0,0"
                             Minimum="0"
                             Maximum="100" />
            </StackPanel>

            <Button x:Name="InstallAndRunButton"
                    Grid.Column="2"
                    Style="{StaticResource ProgramActionButtonStyle}"
                    Content="Выберите программу"
                    IsEnabled="False"
                    Click="InstallAndRunButton_Click" />
        </Grid>
    </Grid>
</Window>
