<Window x:Class="RollHelperLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RollHelper Launcher"
        Width="980"
        Height="640"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="RollHelper Launcher"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <TextBlock Text="Программы и дополнения RollHelper"
                               FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock x:Name="LauncherVersionText"
                               Margin="8,0,0,0"
                               FontSize="14"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </StackPanel>
            </StackPanel>

            <WrapPanel Grid.Row="1"
                       Margin="0,14,0,0"
                       HorizontalAlignment="Right">
                <Button x:Name="UpdateLauncherButton"
                        Content="Проверить обновление лаунчера"
                        Margin="0,0,10,0"
                        Padding="12,7"
                        FontSize="13"
                        Background="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        Foreground="White"
                        Click="UpdateLauncherButton_Click" />
                <Button x:Name="RefreshButton"
                        Content="Обновить список программ"
                        Margin="0,0,10,0"
                        Padding="12,7"
                        FontSize="13"
                        Click="RefreshButton_Click" />
                <Button Content="Открыть лог"
                        Padding="12,7"
                        FontSize="13"
                        Click="OpenLogButton_Click" />
            </WrapPanel>
        </Grid>

        <Grid x:Name="PackagesLayoutGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ProgramsColumn" Width="*" />
                <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                <ColumnDefinition x:Name="ModulesColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Программы"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="Выберите программу, чтобы увидеть её дополнения"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>

                    <DataGrid x:Name="ProgramsGrid"
                              Grid.Row="2"
                              AutomationProperties.Name="Список программ"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              CanUserResizeColumns="True"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              RowHeight="42"
                              ColumnHeaderHeight="38"
                              FontFamily="Segoe UI"
                              FontSize="13"
                              SelectionChanged="ProgramsGrid_SelectionChanged"
                              MouseLeftButtonUp="ProgramsGrid_MouseLeftButtonUp"
                              MouseDoubleClick="ProgramsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding DisplayName}" Width="1.2*" MinWidth="110" />
                            <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="72" MinWidth="58" />
                            <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="*" MinWidth="105" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter x:Name="PackagesSplitter"
                          Grid.Column="1"
                          Width="8"
                          Margin="4,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="#DDE3EA"
                          Cursor="SizeWE"
                          ToolTip="Перетащите, чтобы изменить ширину панелей"
                          Visibility="Collapsed"
                          DragCompleted="PackagesSplitter_DragCompleted"
                          ShowsPreview="True" />

            <Border x:Name="ModulesPanel"
                    Grid.Column="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="#DDE3EA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ModulesHeaderText"
                                       Text="Дополнения"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ModulesHintText"
                                       Margin="0,3,0,0"
                                       Text="Сначала выберите программу слева"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="10,0,0,0"
                                Padding="10,5"
                                MinHeight="30"
                                FontSize="12"
                                VerticalAlignment="Top"
                                Content="Скрыть"
                                ToolTip="Снять выбор программы и закрыть дополнения"
                                Click="HideModulesButton_Click" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="ModulesGrid"
                                  AutomationProperties.Name="Список дополнений"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  RowHeaderWidth="0"
                                  RowHeight="42"
                                  ColumnHeaderHeight="38"
                                  FontFamily="Segoe UI"
                                  FontSize="13"
                                  SelectionChanged="ModulesGrid_SelectionChanged"
                                  MouseDoubleClick="ModulesGrid_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu Opened="ModuleContextMenu_Opened">
                                    <MenuItem x:Name="ContextInstallModuleItem"
                                              Header="Установить"
                                              Click="ContextInstallModuleItem_Click" />
                                    <MenuItem x:Name="ContextDisableModuleItem"
                                              Header="Отключить"
                                              Click="ContextDisableModuleItem_Click" />
                                    <Separator />
                                    <MenuItem x:Name="ContextRemoveModuleItem"
                                              Header="Удалить"
                                              Click="ContextRemoveModuleItem_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding DisplayName}" Width="1.2*" MinWidth="110" />
                                <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="72" MinWidth="58" />
                                <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="*" MinWidth="100" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock x:Name="ModulesEmptyText"
                                   Text="Для этой программы пока нет дополнений"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="InstallEnableModuleButton"
                                Content="Установить"
                                IsEnabled="False"
                                Click="InstallEnableModuleButton_Click" />
                        <Button x:Name="DisableModuleButton"
                                Grid.Column="2"
                                Content="Отключить"
                                IsEnabled="False"
                                Click="DisableModuleButton_Click" />
                        <Button x:Name="RemoveModuleButton"
                                Grid.Column="4"
                                Content="Удалить"
                                IsEnabled="False"
                                Click="RemoveModuleButton_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Text="Выберите программу"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <ProgressBar x:Name="DownloadProgress"
                             Height="8"
                             Margin="0,8,0,0"
                             Minimum="0"
                             Maximum="100" />
            </StackPanel>

            <Button x:Name="InstallAndRunButton"
                    Grid.Column="2"
                    MinWidth="230"
                    Content="Выберите программу"
                    IsEnabled="False"
                    Click="InstallAndRunButton_Click" />
        </Grid>
    </Grid>
</Window>
