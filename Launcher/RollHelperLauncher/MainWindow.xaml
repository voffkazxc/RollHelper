<Window x:Class="RollHelperLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RollHelper Launcher"
        Width="860"
        Height="560"
        MinWidth="720"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="RollHelper Launcher"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="Программы и дополнения RollHelper"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button x:Name="RefreshButton"
                        Content="Обновить список"
                        Margin="0,0,10,0"
                        Click="RefreshButton_Click" />
                <Button Content="Открыть лог"
                        Click="OpenLogButton_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#DDE3EA"
                BorderThickness="1"
                CornerRadius="8"
                Padding="1">
            <DataGrid x:Name="PackagesGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      RowHeight="42"
                      ColumnHeaderHeight="38"
                      FontFamily="Segoe UI"
                      FontSize="14"
                      SelectionChanged="PackagesGrid_SelectionChanged"
                      MouseDoubleClick="PackagesGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding DisplayName}" Width="*" />
                    <DataGridTextColumn Header="Категория" Binding="{Binding Type}" Width="150" />
                    <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="130" />
                    <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="180" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Text="Выберите программу или дополнение"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource SecondaryTextBrush}" />
                <ProgressBar x:Name="DownloadProgress"
                             Height="8"
                             Margin="0,8,0,0"
                             Minimum="0"
                             Maximum="100" />
            </StackPanel>

            <Button x:Name="InstallAndRunButton"
                    Grid.Column="2"
                    MinWidth="230"
                    Content="Выберите компонент"
                    IsEnabled="False"
                    Click="InstallAndRunButton_Click" />
        </Grid>
    </Grid>
</Window>
